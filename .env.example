# Copy to .env and fill in. The app refuses to start with missing values.

# Ollama HTTP API (the laptop that runs the models)
OLLAMA_URL=http://localhost:11434
# Chat/personality model (pulled with `ollama pull`)
CHAT_MODEL=qwen3:8b
# Embedding model for the Digimon lore index
EMBED_MODEL=nomic-embed-text
# SearXNG instance for web search. Leave empty to disable web search.
SEARXNG_URL=http://localhost:8888
# Where state.json and the lore index live (gitignored)
DATA_DIR=./data
# HTTP port the app listens on (0.0.0.0, so the phone can reach it)
PORT=3030
